#cloud-config
autoinstall:
  version: 1

  locale: en_US.UTF-8

  keyboard:
    layout: us

  timezone: Asia/Baku

  identity:
    hostname: ubuntu-vps
    username: packer
    password: ${packer_password_hash}

  ssh:
    install-server: true
    allow-pw: true
    authorized-keys:
      - ${packer_public_key}

  storage:
    layout:
      name: direct

  packages:
    - openssh-server
    - sudo
    - curl
    - vim
    - chrony
    - open-vm-tools
    - cloud-init

  updates: all

  late-commands:
    - curtin in-target --target=/target -- bash -c "echo 'packer ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/packer"
    - curtin in-target --target=/target -- chmod 440 /etc/sudoers.d/packer
    - curtin in-target --target=/target -- systemctl enable ssh
    - curtin in-target --target=/target -- systemctl enable chrony
    - curtin in-target --target=/target -- systemctl enable open-vm-tools
