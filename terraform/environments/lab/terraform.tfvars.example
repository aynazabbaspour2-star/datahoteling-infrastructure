vm_name = "datahoteling-lab-vm"

# Replace with the actual resource pool ID discovered from ESXi.
resource_pool_id = "REPLACE_WITH_RESOURCE_POOL_ID"

num_cpus = 2
memory   = 4096

# AlmaLinux 9 VMware guest ID.
guest_id = "almalinux9_64Guest"

disk_size_gb         = 20
disk_label           = "disk0"
disk_unit_number     = 0
disk_controller_type = "scsi"
thin_provisioned     = true

network_adapter_type = "vmxnet3"
power_state          = "off"
