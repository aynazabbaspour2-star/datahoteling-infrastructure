# vSphere connection
vsphere_server   = "192.168.1.42"
vsphere_user     = "Administrator@vsphere.local"
vsphere_password = "REPLACE_WITH_VSPHERE_PASSWORD"

# Existing vSphere infrastructure
datacenter_name = "DataHoteling-DCDatacenter"
esxi_host       = "192.168.1.21"
datastore_name  = "datastore1"
network_name    = "VM Network"

# VPS operating system
# Supported values: almalinux, ubuntu
os_type = "ubuntu"

# Packer-built golden image templates
# Replace these with the actual vSphere template UUIDs.
template_uuids = {
  almalinux = "REPLACE_WITH_ALMALINUX_TEMPLATE_UUID"
  ubuntu    = "REPLACE_WITH_UBUNTU_TEMPLATE_UUID"
}

# VPS
vm_name = "datahoteling-vps-test-01"

num_cpus = 2
memory   = 2048

disk_size_gb         = 20
disk_label           = "disk0"
disk_unit_number     = 0
disk_controller_type = "scsi"
thin_provisioned     = true

network_adapter_type = "vmxnet3"
